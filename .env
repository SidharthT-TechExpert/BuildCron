# Target server health endpoint
TARGET_URL=https://hired-be.sidhartht.online/api/v1/health

# Regular ping interval (in minutes)
INTERVAL_MINUTES=13

# Retry interval when server is sleeping/waking up (in seconds)
RETRY_INTERVAL_SECONDS=30

# Request timeout in milliseconds (Render cold starts can take 30-50s)
REQUEST_TIMEOUT_MS=35000

# ------------------------------------------------------------------
# 24/7 OPERATION TOGGLE:
# Set to 'true' to run 24/7 continuously without pausing.
# Set to 'false' to pause requests during PAUSE_START_HOUR to PAUSE_END_HOUR.
# ------------------------------------------------------------------
ENABLE_24_7=false

# Off-hours window (24-hour format, 0-23)
# 1 = 01:00 AM (night), 5 = 05:00 AM (morning)
# Note: If you meant 1:00 PM to 5:00 PM (afternoon), change to 13 and 17.
PAUSE_START_HOUR=1
PAUSE_END_HOUR=5

# Timezone for off-hours evaluation (e.g., Asia/Kolkata, UTC, etc.)
TIMEZONE=Asia/Kolkata

# Save logs to a local file (cron.log)
LOG_TO_FILE=true
